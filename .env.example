# ============================================================
#  ENVIRONMENT SWITCH
#  Sirf neeche wale block me comment / uncomment karo,
#  phir `npm run build` chala do. Bas itna hi.
#  (dotenv me pehli value jeetti hai — isliye ek time par
#   sirf EK VITE_API_BASE_URL line uncommented rakhna.)
# ============================================================

# ---------- PRODUCTION (live) ----------
VITE_API_BASE_URL=https://restaurents-api.cylsys.com/api

# ---------- UAT (testing) ----------
# VITE_API_BASE_URL=https://fumesandflavoursapi.cylsysuat.com/api

# ============================================================
#  Baaki settings — inhe normally chhedne ki zaroorat nahi
# ============================================================

# Browser kahan /api call kare. "/api" = same-origin proxy.
VITE_API_PROXY_BASE=/api

VITE_IMAGE_BASE_URL=https://restaurents-api.cylsys.com
VITE_DOMAIN_API_BASE_URL=https://fumesandflavoursapi.cylsysuat.com/api
