{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/domain-api/WebsiteUrl/by-domain",
      "destination": "https://restaurents-api.cylsys.com/api/WebsiteUrl/by-domain"
    },
    {
      "source": "/domain-api/QR/qrcontext",
      "destination": "https://restaurents-api.cylsys.com/api/QR/qrcontext"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
